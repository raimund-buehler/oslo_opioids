library(dplyr)
library(readr)
library(lme4)
library(emmeans)


#Working directory
setwd("C:/Users/priva/Documents/GitHub/oslo_opioids/data/analyses")
# ---------------------------------------------
# Load data
# ---------------------------------------------
df <- read_csv("fix_perc_ASQ_GEN.csv")

# ---------------------------------------------
# Filter: full sample, eye region only
# ---------------------------------------------
df_eye <- df %>% 
  filter(AOI == "eye_brow")

# ---------------------------------------------
# Prepare variables
# ---------------------------------------------
df_eye$ASQ <- as.numeric(df_eye$ASQ)

# Convert 0–100 → 0–1 proportion
df_eye$prop <- df_eye$FixTimePerc / 100

# Avoid zeros/ones for logit transform
eps <- 1e-6
df_eye$prop_adj <- pmin(pmax(df_eye$prop, eps), 1 - eps)

# Logit transform
df_eye$logit_prop <- qlogis(df_eye$prop_adj)

# ---------------------------------------------
# MODEL 1: Fixation ~ ASQ + (1|ID)
# ---------------------------------------------
model1_asq <- lmer(
  logit_prop ~ ASQ + (1 | ID),
  data = df_eye
)

cat("\n======================\nMODEL 1 (ASQ only)\n======================\n")
print(summary(model1_asq))

# ---------------------------------------------
# SIMPLE SLOPE / ESTIMATED TREND
# ---------------------------------------------
emm_asq <- emtrends(model1_asq, ~ 1, var = "ASQ")

cat("\n\nASQ Slope:\n")
print(emm_asq)

library(ggplot2)
library(effects)

library(effects)
library(ggplot2)

# Remove missing ASQ values
df_eye_clean <- df_eye %>% filter(!is.na(ASQ))

# Partial effect
eff_asq <- effect("ASQ", model1_asq,
                  xlevels = list(ASQ = seq(min(df_eye_clean$ASQ),
                                           max(df_eye_clean$ASQ),
                                           length = 100)))

eff_df <- as.data.frame(eff_asq)

# Back-transform
eff_df$fit_prop   = plogis(eff_df$fit)
eff_df$lower_prop = plogis(eff_df$lower)
eff_df$upper_prop = plogis(eff_df$upper)

ggplot() +
  geom_point(aes(x = df_eye_clean$ASQ, y = df_eye_clean$prop), alpha = 0.3) +
  geom_line(aes(x = eff_df$ASQ, y = eff_df$fit_prop), color = "blue", size = 1.2) +
  geom_ribbon(aes(x = eff_df$ASQ, ymin = eff_df$lower_prop, ymax = eff_df$upper_prop),
              fill = "blue", alpha = 0.15) +
  labs(
    title = "Partial Effect of ASQ on Eye Fixation",
    x = "ASQ",
    y = "Fixation Proportion (0–1)"
  ) +
  theme_minimal(base_size = 14)


# Save plot
ggsave("ASQ_effect_eye_fixation.png", width = 8, height = 6)
