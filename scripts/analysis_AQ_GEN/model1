library(dplyr)
library(glmmTMB)
library(emmeans)
library(readr)
library(here)

# =====================================================================
# Load data
# =====================================================================
df <- read_csv(here("data", "analyses", "fix_perc_ASQ_GEN.csv"))


# Restrict to EYE region only (pre-registered area of interest)
df_eye <- df %>%
  filter(AOI == "eye_brow")

# Factor coding
df_eye$Drug <- factor(df_eye$Drug,
                      levels = c("placebo", "morphine", "naltrexone"))

df_eye$Genetics <- factor(df_eye$Genetics,
                          levels = c("A", "G"))   # A/A vs A/G

# =====================================================================
# Beta transformation (FixTimePerc → proportion)
# =====================================================================
df_eye$FixProp <- df_eye$FixTimePerc / 100

# zero/one adjustment
eps <- 1e-6
df_eye$FixProp_beta <- pmin(pmax(df_eye$FixProp, eps), 1 - eps)


#H2: Higher ASQ scores will be associated with lower fixation percentages on the eye region.
#EH4.1: G allele carriers will show higher fixation percentages on the eye region compared to A/A homozygotes.


# =====================================================================
# MODEL 1
# =====================================================================
model1 <- glmmTMB(
  FixProp_beta ~ Drug + ASQ + Genetics + (1 | ID),
  family = beta_family(link="logit"),
  data = df_eye
)

print(summary(model1))

emm_drug <- emmeans(model1, ~ Drug)
print(contrast(emm_drug, method = "pairwise", adjust = "tukey"))

emm_asq <- emtrends(model1, ~ 1, var = "ASQ")
emm_asq

emm_geno <- emmeans(model1, ~ Genetics)
print(contrast(emm_geno, method = "pairwise"))

